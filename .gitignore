# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/out/

# production
/build
apps/*-mobile/dist/

# Expo
**/.expo/

# misc
.DS_Store
*.pem
.npmrc
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server*.log
.next-dev*.log
.local-logs/
.pilot-evidence/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/packages/database/src/generated/prisma
/apps/web/src/generated/prisma/*
!/apps/web/src/generated/prisma/client.ts
!/apps/web/src/generated/prisma/enums.ts

.vercel
.env*.local
