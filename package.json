{
  "name": "deliver",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @deliver/web",
    "dev:local": "tsx --tsconfig tsconfig.json scripts/start-local-dev.ts",
    "mobile:start": "npm run start --workspace @deliver/customer-mobile",
    "mobile:android": "npm run android --workspace @deliver/customer-mobile",
    "mobile:typecheck": "npm run typecheck --workspace @deliver/customer-mobile",
    "mobile:export": "npm run export --workspace @deliver/customer-mobile",
    "build": "npm run build --workspace @deliver/web",
    "start": "npm run start --workspace @deliver/web",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:check": "tsx --tsconfig tsconfig.json scripts/check-app-boundaries.ts",
    "release:check-api": "tsx --tsconfig tsconfig.json scripts/check-release-api.ts",
    "release:check-env": "tsx --tsconfig tsconfig.json scripts/check-release-env.ts",
    "release:check-env:production": "tsx --tsconfig tsconfig.json scripts/check-release-env.ts --target production",
    "release:preflight-vercel": "tsx --tsconfig tsconfig.json scripts/check-vercel-preflight.ts",
    "release:gate": "tsx --tsconfig tsconfig.json scripts/run-release-gate.ts",
    "release:verify-deployed": "tsx --tsconfig tsconfig.json scripts/verify-deployed-release.ts",
    "release:verify-local-prod": "tsx --tsconfig tsconfig.json scripts/verify-local-production.ts",
    "smoke:cash-order": "tsx --tsconfig tsconfig.json scripts/smoke-cash-order.ts",
    "smoke:customer-api": "tsx --tsconfig tsconfig.json scripts/smoke-customer-api.ts",
    "smoke:reset-fixtures": "tsx --tsconfig tsconfig.json scripts/reset-smoke-fixtures.ts",
    "acceptance:pilot": "tsx --tsconfig tsconfig.json scripts/acceptance-pilot-role-flow.ts",
    "acceptance:viewports": "tsx --tsconfig tsconfig.json scripts/check-pilot-viewports.ts",
    "auth:reset-local-rate-limits": "tsx --tsconfig tsconfig.json scripts/reset-local-auth-rate-limits.ts",
    "jobs:dispatch-tick": "tsx --tsconfig tsconfig.json scripts/run-dispatch-tick.ts",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 start",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 stop",
    "db:local:status": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 status",
    "db:local:psql": "powershell -ExecutionPolicy Bypass -File scripts/local-postgres.ps1 psql",
    "db:dev:start": "powershell -ExecutionPolicy Bypass -File scripts/start-prisma-dev.ps1",
    "db:dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-prisma-dev.ps1",
    "db:dev:ls": "powershell -ExecutionPolicy Bypass -File scripts/list-prisma-dev.ps1",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@deliver/auth": "*",
    "@deliver/contracts": "*",
    "@deliver/database": "*",
    "@deliver/domain": "*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.20.0",
    "@next/env": "16.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
