# Runtime URL. Use a pooled endpoint on Vercel (Neon host contains "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deliver?schema=public"
# Prisma CLI/migrations URL. Staging and production require a separate direct endpoint.
PRISMA_DATABASE_URL=""
# Per-Vercel-instance node-postgres pool limits and timeouts.
DATABASE_POOL_MAX="5"
DATABASE_CONNECTION_TIMEOUT_MS="5000"
DATABASE_IDLE_TIMEOUT_MS="10000"

# local, staging or production. Staging/production enable closed-pilot launch checks.
RELEASE_TARGET="local"
# Database environment identity: local, staging or production.
# For staging/production this must exactly match RELEASE_TARGET.
RELEASE_DATABASE_TAG="local"

# Development OTP mode does not send SMS/WhatsApp/Telegram.
OTP_PROVIDER="dev"
# In production, OTP_PROVIDER=dev is allowed only for a closed pilot.
CLOSED_PILOT_OTP_ENABLED="false"
CLOSED_PILOT_OTP_PHONE_ALLOWLIST="+77000000001,+77000000002,+77000000003"

# Geo provider. Use "dev" without external keys, or "2gis" with real 2GIS keys.
GEO_PROVIDER="dev"
TWOGIS_API_KEY=""
NEXT_PUBLIC_TWOGIS_MAP_KEY=""

# Required for Vercel Cron and /api/jobs/* endpoints.
CRON_SECRET=""
# Production dispatch uses the per-minute Vercel cron in vercel.json.
# Vercel Hobby supports only daily cron jobs, so production must use "pro" or "enterprise".
VERCEL_ACCOUNT_PLAN="pro"

# Used by release:check-api against local, staging or production-like deployments.
APP_BASE_URL="http://localhost:3000"
# Set to 1 only when intentionally checking localhost while RELEASE_TARGET is not local.
ALLOW_LOCAL_API_CHECK="0"

# Smoke and deployed acceptance create real orders. Enable only the intended target.
SMOKE_ALLOW_STAGING_WRITE="0"
SMOKE_ALLOW_PRODUCTION_WRITE="0"
